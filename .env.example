# Environment variables for the ILL Django backend.
#
# This file is documentation only: Django does not load it automatically and
# there is no python-dotenv/django-environ in requirements.txt. Export these in
# your shell, or set them in the Render dashboard under Environment, where the
# application reads them via os.getenv().
#
# Copy to .env if you add a loader later. The real .env is gitignored.
#
# Never commit real credentials. CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS
# are hardcoded in config/settings.py rather than read from the environment.

# --- Django core -------------------------------------------------------------

# Required in production. The default in settings.py is a known development key
# and must not be used on a deployed instance.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=development-only-change-me-before-deployment-123456789

# "true" or "false". Defaults to "true". Set to "false" on Render; this also
# enables SECURE_SSL_REDIRECT, HSTS, and the secure session/CSRF cookies.
DJANGO_DEBUG=true

# Comma-separated hostnames. Defaults to "127.0.0.1,localhost".
# On Render use the service hostname, e.g. ill-o1k2.onrender.com (letter o, not zero)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# HSTS max-age in seconds. Defaults to 31536000 (1 year) when DEBUG is false and
# 0 when DEBUG is true. Set to 0 to disable HSTS while debugging TLS issues.
# DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Initial admin account (accounts/management/commands/create_admin_once.py) --

# ADMIN_EMAIL is mandatory for the command to do anything; without it the
# command logs "ADMIN_EMAIL is not set; skipping admin provisioning" and exits 0.
# The account is created with is_staff and is_superuser set.
ADMIN_EMAIL=

# Required only when the account does not exist yet. Minimum 8 characters.
# Ignored for an existing account unless --reset-password is passed.
ADMIN_PASSWORD=

# Optional, defaults to "Admin".
ADMIN_FIRST_NAME=Admin

# --- Runtime (set by the platform, not by you) -------------------------------

# Port gunicorn must bind to. Render injects this; do not hardcode a value.
# PORT=10000
